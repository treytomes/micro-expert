// facts.kb — the family the program reasons about: 54 facts about people.
//
// A fact is one SPO triple, predicate(subject, object), so "?x is the relation of
// ?y" reads with the subject first. Values are names or plain numbers; ?x would be a
// variable, which a stored fact never needs. Nothing here is derived — rules.kb says
// what follows from these.
//
// Blank lines and // comments are skipped, and a fact may run on to the next line
// inside its parentheses. knowledge.ms parses the format; facts.ms loads this file.

// Walter and Doris.
has-gender(walter, male)
has-birthdate(walter, 1948-03-14)
has-gender(doris, female)
has-birthdate(doris, 1950-06-02)
married-to(walter, doris)

// Their three sons.
is-parent-of(walter, bill)
is-parent-of(doris, bill)
is-parent-of(walter, george)
is-parent-of(doris, george)
is-parent-of(walter, henry)
is-parent-of(doris, henry)
has-gender(bill, male)
has-birthdate(bill, 1972-01-30)
has-gender(george, male)
has-birthdate(george, 1975-05-11)
has-gender(henry, male)
has-birthdate(henry, 1979-02-08)

// Bill and Susan, with one son.
married-to(bill, susan)
has-gender(susan, female)
has-birthdate(susan, 1974-07-19)
is-parent-of(bill, tim)
is-parent-of(susan, tim)
has-gender(tim, male)
has-birthdate(tim, 2002-04-05)

// George and Diane, with a daughter and a son.
married-to(george, diane)
has-gender(diane, female)
has-birthdate(diane, 1977-09-23)
is-parent-of(george, anna)
is-parent-of(diane, anna)
is-parent-of(george, mark)
is-parent-of(diane, mark)
has-gender(anna, female)
has-birthdate(anna, 2005-02-14)
has-gender(mark, male)
has-birthdate(mark, 2008-06-30)

// Henry and Rachel, with two daughters and two sons.
married-to(henry, rachel)
has-gender(rachel, female)
has-birthdate(rachel, 1981-03-03)
is-parent-of(henry, clara)
is-parent-of(rachel, clara)
is-parent-of(henry, jack)
is-parent-of(rachel, jack)
is-parent-of(henry, nina)
is-parent-of(rachel, nina)
is-parent-of(henry, oliver)
is-parent-of(rachel, oliver)
has-gender(clara, female)
has-birthdate(clara, 2011-05-27)
has-gender(jack, male)
has-birthdate(jack, 2013-08-16)
has-gender(nina, female)
has-birthdate(nina, 2016-03-12)
has-gender(oliver, male)
has-birthdate(oliver, 2019-01-25)
