// schema.kb — the type of each predicate's fields, in the order a fact writes them.
//
//   predicate(field type, field type)
//
// A type is
//
//   number    any number, whole or fractional: 24, 24.5, -3, 1e3
//   text      any text, which is what a person or a word is here
//   boolean   the word true or the word false
//   date      a calendar date, yyyy-MM-dd: 2019-04-01
//   time      a clock time, HH:mm:ss: 09:30:00
//   datetime  a date and a clock time, yyyy-MM-dd HH:mm:ss: 2019-04-01 09:30:00
//   a|b|c     one of these words, exactly
//   unique(t) t, and at most one such value per subject: unique(number)
//
// The prompt holds a typed fact against this before storing it, so has-age(tim, twenty)
// is refused rather than filed away where no rule could ever reach it. A question is held
// to it too, before it is searched, so has-age(?a, twenty) is refused where it is typed. A
// predicate the file does not name is accepted as it is written.
//
// unique(...) around a field's type is about the pair rather than the value: has-birthdate's
// date is one per person, so a second birthdate for tim is refused by the prompt and by the
// loader, which is why this file is read before the facts are. A stored predicate is the
// only kind that can carry it, since a fact a rule concludes is never added, and a
// schema line that puts one on a derived predicate is refused when the program starts.
//
// Both stored and derived predicates are listed, because both can be written and asked at
// the prompt. A stored predicate's line comes from the facts that use it; a derived one's
// from the rules that conclude it, since every condition in a body says what its fields
// have to be - is-sibling-of takes the two people is-parent-of links, and belongs-to-age-group's second
// field is one of the two words its rules write. A comparison such as
// less-than-or-equal(?n, 18) keeps its own field a number without being told.
//
// knowledge.ms reads this file; schema.ms loads it for main.ms.

// ── Stored facts ─────────────────────────────────────────────────────────────

is-parent-of(text, text)
married-to(text, text)
has-gender(text, unique(male|female))
has-birthdate(text, unique(date))

// ── The place a lookup answers with ─────────────────────────────────────────

// The names are the words the service sent and the coordinates are numbers, which is what the
// location module writes; a geocoder spells its coordinates as text, and that is refused here.
// A place has one set of coordinates, so a service's second latitude - a search correcting what
// a lookup said - takes the first's place rather than standing beside it, as the service pages
// write these two fields and docs/api/geocode-maps-co.md says why.
has-location(text, text)
has-continent(text, text)
has-country(text, text)
has-region(text, text)
has-city(text, text)
has-latitude(text, unique(number))
has-longitude(text, unique(number))

// ── The place a geocoder answers with ───────────────────────────────────────
// docs/api/geocode-maps-co.md's vocabulary for one result. has-latitude, has-longitude,
// has-city and has-country are the lookup's lines above, since one place's coordinate is one
// number and one place's name is text whichever service supplied it; these are the rest.

has-name(text, text)
has-name-in-fr(text, text)
has-south-latitude(text, unique(number))
has-north-latitude(text, unique(number))
has-west-longitude(text, unique(number))
has-east-longitude(text, unique(number))
has-osm-class(text, text)
has-osm-type(text, text)
has-place-rank(text, unique(number))
has-importance(text, unique(number))
has-place-id(text, unique(number))
has-house-number(text, unique(text))
has-road(text, unique(text))
has-country-code(text, unique(text))
has-wikidata(text, unique(text))
has-wikipedia(text, unique(text))
has-fee(text, text)
was-answer-to(text, text)

// ── The readings a forecast answers with ────────────────────────────────────
// docs/api/open-meteo.md's vocabulary for one hour of a reply. The subject is the place and
// the hour is the fact's '@', so none of these is unique: two hours of one variable are two
// facts, told apart by the span they cover.

has-temperature-2m(text, number)
has-relative-humidity-2m(text, number)
has-precipitation(text, number)
has-wind-speed-10m(text, number)
has-weather-code(text, number)

// ── Derived by rules ─────────────────────────────────────────────────────────

is-child-of(text, text)
is-sibling-of(text, text)
is-brother-of(text, text)
is-sister-of(text, text)
is-uncle-of(text, text)
is-aunt-of(text, text)
is-grandpa-of(text, text)
is-grandma-of(text, text)
is-in-law-of(text, text)
is-only-child-of(text, text)
has-age(text, number)
// The same reading in another unit, worked out by the rules in data/rules.kb rather than stored:
// the two are not unique, since a place has one of each for every hour of its day.
has-fahrenheit-value(text, number)
has-celsius-value(text, number)
belongs-to-age-group(text, child|adult)
shares-age-group-with(text, text)

// A place is a location by rule: is-a(?x, location) holds for anything with both coordinates.
is-a(text, text)
