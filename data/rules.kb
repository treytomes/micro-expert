// rules.kb — the rules this program uses: what follows from the facts in facts.kb.
//
// One rule per line, as
//
//   head => body
//
// where head is a fact, predicate(subject, object), and body is one condition or a
// comma-delimited list of them — all of which must hold. The list is an implied and,
// and and(...) says the same thing out loud and nests. or(...) holds alternatives,
// any one of which may hold instead, so a rule with two readings is one line, and
// not(...) holds a body that must have no proof, so a rule can ask for an absence.
// A condition is a fact, a constraint not-equal(?x, ?y) or equal(?n, 18), a comparison
// less-than-or-equal(?n, 18), or a grouping.
// A fact reads
// "?x is the relation of ?y", so ?x comes first.
//
// Blank lines and // comments are skipped. A rule may run on to the next line, inside
// its parentheses or after the arrow, so a long body can be broken where it reads best.
//
// knowledge.ms parses the format; rules.ms loads this file into the engine.

// ?x is the child of ?y when ?y is a parent of ?x.
is-child-of(?x, ?y) => is-parent-of(?y, ?x)

// Marriage is a two-way street, so one fact per couple can answer from either side.
married-to(?y, ?x) => married-to(?x, ?y)

// ?x and ?y are siblings when they share at least one parent, so half-siblings count
// too, and nobody is their own sibling.
is-sibling-of(?x, ?y) => and(is-parent-of(?p, ?x), is-parent-of(?p, ?y), not-equal(?x, ?y))

// ?x is a brother of ?y when ?x is a male sibling, so the gender is asked of ?x
// rather than of ?y.
is-brother-of(?x, ?y) => and(is-sibling-of(?x, ?y), has-gender(?x, male))

// ?x is a sister of ?y when ?x is a female sibling.
is-sister-of(?x, ?y) => and(is-sibling-of(?x, ?y), has-gender(?x, female))

// ?x is an uncle of ?y when ?x is a male sibling of one of ?y's parents.
is-uncle-of(?x, ?y) => and(is-parent-of(?p, ?y), is-sibling-of(?x, ?p), has-gender(?x, male))

// ?x is an aunt of ?y when ?x is a female sibling of one of ?y's parents.
is-aunt-of(?x, ?y) => and(is-parent-of(?p, ?y), is-sibling-of(?x, ?p), has-gender(?x, female))

// ?x is a grandpa of ?y when ?x is a male parent of one of ?y's parents.
is-grandpa-of(?x, ?y) => and(is-parent-of(?p, ?y), is-parent-of(?x, ?p), has-gender(?x, male))

// ?x is a grandma of ?y when ?x is a female parent of one of ?y's parents.
is-grandma-of(?x, ?y) => and(is-parent-of(?p, ?y), is-parent-of(?x, ?p), has-gender(?x, female))

// ?x is an in-law of ?y when ?x married ?y's sibling, or ?x's sibling married ?y.
// The two readings have nothing in common but the head - one asks about ?x's
// spouse, the other about ?y's - so one or(...) says both.
is-in-law-of(?x, ?y) => or(and(married-to(?x, ?p), is-sibling-of(?p, ?y)), and(is-sibling-of(?x, ?p), married-to(?p, ?y)))

// ?x is the only child of ?y when ?y is a parent of ?x and nobody is a sibling of ?x.
// Only not(...) can say that: is-sibling-of(?x, ?q) holds for any ?q, so no condition of
// the graph asks whether one exists - the rule holds when the search finds none.
is-only-child-of(?x, ?y) => and(is-parent-of(?y, ?x), not(is-sibling-of(?x, ?q)))

// ?x is ?n years old on the day this runs. The birthdate is the fact and the age is
// arithmetic, so years-since(...) does the counting: a goal can only prove a fact, and a
// comparison only reads a number that is already there.
has-age(?x, ?n) => and(has-birthdate(?x, ?b), years-since(?b, ?n))

// ?x is a child while ?x is 18 or younger. The age is a number the rule above worked
// out, so the comparison is arithmetic: read as text, "9" would sort after "18".
belongs-to-age-group(?x, child) => and(has-age(?x, ?n), less-than-or-equal(?n, 18))

// ?x is an adult when ?x has an age and is not a child - the same line the other way
// round, so the age where childhood ends is written once. has-age comes first because
// a negation cannot go looking: it can only report that a body with ?x already bound
// has no proof.
belongs-to-age-group(?x, adult) => and(has-age(?x, ?n), not(belongs-to-age-group(?x, child)))

// ?x and ?y are in the same age group when both fall into one and it is the same one.
// The two groups are reached by separate conditions, so equal(?g, ?h) is what says they
// have to agree - and it is written the moment ?g is known, so ?h is already bound when
// the second condition goes looking for the people in it.
shares-age-group-with(?x, ?y) => and(belongs-to-age-group(?x, ?g), equal(?g, ?h), belongs-to-age-group(?y, ?h), not-equal(?x, ?y))

is-a(?x, location) => and(has-latitude(?x, ?y), has-longitude(?x, ?z))

// A temperature read in Celsius is one written in Fahrenheit: ?f is ?c through the arithmetic,
// and the reading's '@' comes through the derivation unchanged, so the hour the reading covers is
// the hour the Fahrenheit value covers. Neither scale is a fact of its own - only the value is
// worked out - so nothing is stored twice and the reading stays the one the service answered.
has-fahrenheit-value(?p, ?f) => and(has-temperature-2m(?p, ?c), equal(?f, add(divide(multiply(?c, 9), 5), 32)))

// ...and back, for a session handed Fahrenheit and asked in Celsius. The head is
// has-celsius-value rather than has-temperature-2m on purpose: two rules that concluded one
// another's body would feed each other, and the arithmetic is floating point, so each pass round
// the pair would drift a hair and a question would answer with a chain of near-copies.
has-celsius-value(?p, ?c) => and(has-fahrenheit-value(?p, ?f), equal(?c, divide(multiply(subtract(?f, 32), 5), 9)))
