{
  "name": "miniscript2",
  "displayName": "MiniScript 2",
  "description": "MiniScript 2 language support for Visual Studio Code: syntax highlighting for .ms files.",
  "version": "0.1.0",
  "publisher": "micro-expert",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "miniscript",
    "miniscript 2",
    "ms"
  ],
  "contributes": {
    "languages": [
      {
        "id": "miniscript",
        "aliases": [
          "MiniScript",
          "MiniScript 2",
          "miniscript"
        ],
        "extensions": [
          ".ms"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "miniscript",
        "scopeName": "source.miniscript",
        "path": "./syntaxes/miniscript.tmLanguage.json"
      }
    ]
  }
}
