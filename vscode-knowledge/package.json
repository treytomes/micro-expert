{
  "name": "micro-expert-knowledge",
  "displayName": "Micro-Expert Knowledge",
  "description": "Syntax highlighting for micro-expert knowledge files (.kb): the facts and rules the engine reasons over.",
  "version": "0.1.1",
  "publisher": "micro-expert",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/treytomes/micro-expert.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "knowledge",
    "facts",
    "rules",
    "kb"
  ],
  "contributes": {
    "languages": [
      {
        "id": "micro-expert-kb",
        "aliases": [
          "Knowledge",
          "micro-expert knowledge"
        ],
        "extensions": [
          ".kb"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "micro-expert-kb",
        "scopeName": "source.micro-expert-kb",
        "path": "./syntaxes/knowledge.tmLanguage.json"
      }
    ]
  }
}
